/**
 * Custom excerpt length
 */
function ops_excerpt_length( $length ) {
    return 30;
}
add_filter( 'excerpt_length', 'ops_excerpt_length' );

function ops_excerpt_more( $more ) {
    return '&hellip;';
}
add_filter( 'excerpt_more', 'ops_excerpt_more' );

